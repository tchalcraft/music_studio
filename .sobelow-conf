[
  verbose: false,
  private: false,
  # Honor inline `# sobelow_skip [...]` annotations (used in BeaconRuntimeCSS, where
  # temp paths + a fixed Tailwind binary trip low-confidence Traversal/CI flags).
  skip: true,
  router: "lib/music_studio_web/router.ex",
  exit: "Low",
  format: "txt",
  # Config.CSP is a known gap. CSP for LiveView needs script nonces and
  # careful handling of inline event handlers — tracked as separate work.
  ignore: ["Config.CSP"]
]
